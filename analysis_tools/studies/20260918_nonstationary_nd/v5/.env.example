# Copy to .env locally. Never commit credentials.
WANDB_API_KEY=
WANDB_PROJECT=optiq_mujoco_v2_confirmation
WANDB_ENTITY=OptiQ
WANDB_MODE=online

# Launcher options must be exported in the shell before invoking the script:
# export OPTIQ_PYTHON=/workspace/.venv-optiq-mujoco/bin/python
# export OPTIQ_ENV_FILE=/absolute/path/to/existing/.env
# Set CUDA_VISIBLE_DEVICES when launching on an allocated GPU.
# Final config is mujoco_v2 (equivalent to mujoco_v2_checked / v2/final).
# W&B project is fixed by that config; override with wandb.project=... if needed.
# Tests are local by default. OPTIQ_TEST_WANDB=1 opts into online test reporting.
