{
  "alg": {
    "tau": 1.0,
    "policy_tau": 1.0,
    "utd": 2,
    "gamma": 0.99,
    "policy_delay": 1,
    "batch_size": 256,
    "buffer_size": 1000000,
    "learning_starts": 5000,
    "reset_models": false,
    "ent_coef": {
      "type": "const",
      "init": 0.0
    },
    "critic": {
      "activation": "relu",
      "n_critics": 2,
      "hs": [
        2048,
        2048
      ],
      "dropout_rate": null,
      "use_layer_norm": false,
      "n_atoms": 101,
      "v_min": -3600,
      "v_max": 3600,
      "entr_coeff": 0.005
    },
    "optimizer": {
      "bn": true,
      "bn_momentum": 0.99,
      "bn_mode": "brn_actor",
      "bn_warmup": 100000,
      "lr_critic": 0.0003,
      "lr_actor": 0.0003,
      "critic_b1": 0.5,
      "critic_b2": 0.999,
      "actor_b1": 0.9,
      "actor_b2": 0.999
    },
    "actor": {
      "hidden_dims": [
        256,
        256,
        256
      ],
      "num_policy_samples": 16,
      "proposals_per_policy_sample": 5,
      "proposal_std": 0.2,
      "proposal_clip": 0.5,
      "include_anchor": true,
      "density_correction": true,
      "source_q_eval": "mean",
      "source_reference": "uniform_action",
      "temperature": 0.25,
      "sinkhorn_epsilon": 0.05,
      "sinkhorn_iterations": 30,
      "transport_target_mode": "argmax",
      "td_noise_std": 0.2,
      "td_noise_clip": 0.5,
      "learning_starts": 5000,
      "density_correction_beta": 0.1,
      "distillation_loss": "pointwise_mse"
    }
  },
  "runtime": {
    "use_jit": true,
    "total_steps": 1000000,
    "task": "pen-twirl-hard",
    "env_name": "myoHandPenTwirlRandom-v0",
    "successful_steps": 5
  },
  "evaluation": {
    "eval_interval": 5000,
    "num_eval_episodes": 10,
    "eval_at_start": true,
    "stochastic_eval": true,
    "checkpoint_interval": 50000,
    "diagnostic_interval": 5000
  }
