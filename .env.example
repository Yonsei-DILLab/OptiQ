# Copy to .env locally. Never commit credentials.
WANDB_API_KEY=
WANDB_PROJECT=optiq_dime_no_anchor
# Optional: defaults to the authenticated account's default entity.
# WANDB_ENTITY=your-team
WANDB_MODE=online

# Launcher options must be exported in the shell before invoking the script:
# export OPTIQ_PYTHON=/workspace/.venv-optiq-no-anchor/bin/python
# export OPTIQ_ENV_FILE=/absolute/path/to/existing/.env
# Set CUDA_VISIBLE_DEVICES when launching on an allocated GPU.
