[program:heejoon-adroit-temp001]
directory=SOURCE_DIRECTORY
command=RUN_ROOT/venv/bin/python -m adroit_online.temp001_controller --root RUN_ROOT --shard SHARD_INDEX
user=heejoonorm
autostart=false
autorestart=false
startsecs=3
stopasgroup=false
killasgroup=false
stopwaitsecs=86400
redirect_stderr=true
stdout_logfile=RUN_ROOT/temp001-controller.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=2
environment=PYTHONUNBUFFERED="1",OMP_NUM_THREADS="1",OPENBLAS_NUM_THREADS="1",MKL_NUM_THREADS="1",NUMEXPR_NUM_THREADS="1"
